{
  "name": "pwa-inspecciones-laboratorio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "node tests/starter.spec.mjs && vitest run",
    "test:unit": "vitest run tests/unit --passWithNoTests --reporter=default --reporter=junit --outputFile.junit=reports/unit-junit.xml",
    "test:integration": "vitest run tests/integration --passWithNoTests --reporter=default --reporter=junit --outputFile.junit=reports/integration-junit.xml",
    "test:coverage": "vitest run --coverage --reporter=default --reporter=junit --outputFile.junit=reports/vitest-junit.xml",
    "test:e2e": "playwright test",
    "verify": "node scripts/verify.mjs"
  },
  "dependencies": {
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20.14.15",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "happy-dom": "^20.14.5",
    "typescript": "^5.4.5",
    "vitest": "^4.1.11"
  }
}
